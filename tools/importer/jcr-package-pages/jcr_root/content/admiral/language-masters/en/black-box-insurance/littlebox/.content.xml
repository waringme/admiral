      <section_3 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" name="What's Admiral LittleBox?" style="[white]" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]">
        <block_1 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" image="/content/dam/admiral/en/images/blackbox/annie-with-alfie-pointing-right.png" model="side-image" modelFields="[image,imageAlt,text,classes_position,classes_align]" name="Side Image" text="&lt;p&gt;&lt;h2&gt;What’s Admiral LittleBox?&lt;/h2&gt;&lt;/p&gt;&lt;p&gt;LittleBox is our original &lt;a href&#x3D;&quot;/black-box-insurance&quot;&gt;black box&lt;/a&gt; product. Our engineers will hard install it into your car, and then you’re all good to go.&lt;/p&gt;&lt;p&gt;Once it’s been fitted, it’ll measure when and how well you drive. If you’re a safe driver, you could get a discount when you renew.&lt;/p&gt;"></block_1>
      </section_3>
      <section_4 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" name="How is LittleBox installed?" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]">
        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="How is LittleBox installed?" titleType="h2"/>
        <block sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" classes_layout="columns" filter="feature-grid" model="feature-grid" modelFields="[classes_layout,classes_text]" name="Feature Grid">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="Book a slot" text="&lt;p&gt;We&#x27;ll send out an engineer on a date that works for you - within 30 days of buying your policy.&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-badge-step-01-desktop.svg" iconMobile="/content/dam/admiral/en/images/blackbox/lb-badge-step-01-mobile.svg"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="An engineer fits the device" text="&lt;p&gt;One of our engineers will fit the box out of sight in your car, normally behind the glovebox.&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-badge-step-02-desktop.svg" iconMobile="/content/dam/admiral/en/images/blackbox/lb-badge-step-02-mobile.svg"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="Drive away" text="&lt;p&gt;Time to take the wheel! Your LittleBox will now be tracking how safely you drive.&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-badge-step-03-desktop.svg" iconMobile="/content/dam/admiral/en/images/blackbox/lb-badge-step-03-mobile.svg"></item_2>
        </block>
      </section_4>
      <section_5 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" name="How does Admiral LittleBox work?" style="[narrow]" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]">
        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="How does Admiral LittleBox work?" titleType="h2"/>
        <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;It uses GPS to keep track of how safely you&#x27;re driving. Then we&#x27;ll give you a driving score based on that, so you can see how you&#x27;re doing.&lt;/p&gt;&lt;p&gt;It gets averaged out over time - so you don&#x27;t need to be a perfect driver to get a good score.&lt;/p&gt;&lt;p&gt;The safer you drive, the better your renewal price is likely to be.&lt;/p&gt;"/>
      </section_5>
      <section_6 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" name="What does LittleBox measure?" style="[grey]" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]">
        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="What does LittleBox measure?" titleType="h2"/>
        <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;There are a few things we look at to decide whether you&#x27;re driving safely.&lt;/p&gt;"/>
        <block_1 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="feature-grid" model="feature-grid" modelFields="[classes_layout,classes_text]" name="Feature Grid">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="Speeding" text="&lt;p&gt;Speeding will bring down your score - and remember, it&#x27;s illegal and dangerous. Keep an eye on how fast you&#x27;re driving and stay within the speed limit.&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-tick.svg"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="Braking" text="&lt;p&gt;We&#x27;ll look at how harshly you brake, so be careful to brake as smoothly as possible and with lots of time to spare.&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-tick.svg"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="Acceleration" text="&lt;p&gt;You might be tempted to go full throttle, but the box will measure how fast you accelerate. Go slow and gradually build up speed to show you&#x27;re fully in control.&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-tick.svg"></item_2>
          <item_3 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="The time of day you drive" text="&lt;p&gt;There&#x27;s no curfew, don&#x27;t worry. But regularly driving at night, between 10pm and 4am, will lower your score. That&#x27;s because people are more likely to be tired and the visibility is worse, so accidents are more likely. If you regularly drive at night, LittleBox might not be right for you.&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-tick.svg"></item_3>
        </block_1>
        <text_1 sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;For more information on how we collect your driving data, check out your &lt;a href&#x3D;&quot;/existing-customers/policy-documents.php&quot;&gt;policy book&lt;/a&gt;.&lt;/p&gt;&lt;p&gt;Remember - if your driving is really unsafe or you have a consistently poor score, we&#x27;ll cancel your policy.&lt;/p&gt;"/>
      </section_6>
      <section_7 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" name="How do I get my feedback?" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]">
        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="How do I get my feedback?" titleType="h2"/>
        <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;Don&#x27;t worry if you&#x27;re not sure how you&#x27;re getting on - we&#x27;ll send you an email each week with an update on your driving score.&lt;/p&gt;"/>
        <block sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" classes_layout="columns" filter="feature-grid" model="feature-grid" modelFields="[classes_layout,classes_text]" name="Feature Grid">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="Good" text="&lt;p&gt;You&#x27;re driving well - keep doing what you&#x27;re doing!&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-badge-good.svg"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="Needs improvement" text="&lt;p&gt;You&#x27;re doing okay! Use our handy driving tips to help boost your score.&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-badge-average.svg"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Feature Row" model="feature-grid-item" title="Poor" text="&lt;p&gt;You&#x27;re driving unsafely right now - use our tips to improve or your policy could be cancelled.&lt;/p&gt;" modelFields="[icon,title,text,iconMobile]" icon="/content/dam/admiral/en/images/blackbox/lb-badge-poor.svg"></item_2>
        </block>
        <text_1 sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;We&#x27;ll give you regular tips on how you could improve your score.&lt;/p&gt;"/>
      </section_7>
      <section_8 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" name="Looking for more?" style="[white,centered]" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]">
        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Looking for more?" titleType="h2"/>
        <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;We also have two other LittleBox products. Heads up - you can&#x27;t choose which LittleBox you get! We decide based on a few different risk factors, like how long you&#x27;ve been driving.&lt;/p&gt;"/>
        <block_1 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" classes="boxed" filter="cards-article" model="cards-article" modelFields="[classes,classes_magazine]" name="Cards Article">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" text="&lt;p&gt;&lt;h3&gt;LittleBox Plug and Drive&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/black-box-insurance/littlebox-plug-and-drive&quot;&gt;Plug and Drive&lt;/a&gt; is a small unit that fits into the 12 volt socket in your car. It doesn&#x27;t need to be fitted by an engineer - you can just plug it in yourself and you&#x27;re ready to go.&lt;/p&gt;"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" text="&lt;p&gt;&lt;h3&gt;LittleBox Pod&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/black-box-insurance/littlebox-pod&quot;&gt;LittleBox Pod&lt;/a&gt; is a small Bluetooth device that&#x27;s fitted to the inside of your windscreen. With this option, you&#x27;ll have access to an app that gives you updates on your driving.&lt;/p&gt;"></item_1>
        </block_1>
      </section_8>
      <section_9 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" name="Black box for van drivers" style="[sky]" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]">
        <block_1 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" classes_align="center" classes_position="right" image="/content/dam/admiral/en/images/blackbox/van.jpg" model="side-image" modelFields="[image,imageAlt,text,classes_position,classes_align]" name="Side Image" text="&lt;p&gt;&lt;h2&gt;Black box for van drivers&lt;/h2&gt;&lt;/p&gt;&lt;p&gt;Do you run a business using your van? Or use it for camping trips on the weekend? Whatever you use it for, we’ve got something for you and your van too.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;/van-insurance/black-box&quot;&gt;Black box van insurance&lt;/a&gt;&lt;/p&gt;"></block_1>
      </section_9>
      <section_10 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" name="Useful guides" style="[centered]" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]">
        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Useful guides" titleType="h2"/>
        <block_1 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" classes="boxed" filter="cards-article" model="cards-article" modelFields="[classes,classes_magazine]" name="Cards Article">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="/content/dam/admiral/en/images/blackbox/guide-what-is-telematics.jpg" text="&lt;p&gt;&lt;h3&gt;What is telematics?&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;Black box insurance is sometimes known as telematics - but what actually is it?&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://www.admiral.com/magazine/guides/motor/what-is-telematics&quot;&gt;Know your stuff&lt;/a&gt;&lt;/p&gt;"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="/content/dam/admiral/en/images/blackbox/guide-black-box-students.jpg" text="&lt;p&gt;&lt;h3&gt;How a black box can help students&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;We know being a student can be expensive. If you have a car and are at uni, black box insurance could be right for you.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://www.admiral.com/magazine/guides/car-insurance/student-car-insurance-how-a-black-box-can-help&quot;&gt;Is it right for you?&lt;/a&gt;&lt;/p&gt;"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Card" model="card" modelFields="[image,text]" image="/content/dam/admiral/en/images/blackbox/guide-car-insurance-buyers.jpg" text="&lt;p&gt;&lt;h3&gt;Car insurance buyer&#x27;s guide&lt;/h3&gt;&lt;/p&gt;&lt;p&gt;Shopping around for car insurance? Here&#x27;s everything you should be thinking about.&lt;/p&gt;&lt;p&gt;&lt;a href&#x3D;&quot;https://www.admiral.com/magazine/guides/car-insurance/car-insurance-buying-advice&quot;&gt;What to look for&lt;/a&gt;&lt;/p&gt;"></item_2>
        </block_1>
      </section_10>
      <section_11 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" name="Admiral LittleBox FAQs" style="[centered]" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]">
        <title sling:resourceType="core/franklin/components/title/v1/title" jcr:primaryType="nt:unstructured" title="Admiral LittleBox FAQs" titleType="h2"/>
        <text sling:resourceType="core/franklin/components/text/v1/text" jcr:primaryType="nt:unstructured" text="&lt;p&gt;Still not 100% on how it all works? We&#x27;ve got some more answers here for you.&lt;/p&gt;"/>
        <block_1 sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" filter="faq-list" name="Faq List">
          <item_0 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Faq List Item" model="faq-list-item" question="Am I eligible to get LittleBox Insurance?" answer="&lt;p&gt;LittleBox can be great for any safe driver looking to save money on their car insurance. There are just a few things to be aware of:&lt;/p&gt;&lt;p&gt;&lt;ol&gt; &lt;li&gt;Your car needs to be worth at least £250&lt;/li&gt; &lt;li&gt;You&#x27;ll need to drive at least 1,000 miles annually&lt;/li&gt; &lt;li&gt;Your car must have been made in the last 15 years&lt;/li&gt; &lt;/ol&gt;&lt;/p&gt;" modelFields="[question,answer]"></item_0>
          <item_1 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Faq List Item" model="faq-list-item" question="Does Admiral LittleBox have an app?" answer="&lt;p&gt;Only our LittleBox Pod product has an app.&lt;/p&gt;&lt;p&gt;With our original LittleBox, which we&#x27;ve spoken about on this page, you&#x27;ll get your updates over email.&lt;/p&gt;" modelFields="[question,answer]"></item_1>
          <item_2 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Faq List Item" model="faq-list-item" question="How do I see my LittleBox score?" answer="&lt;p&gt;Every week that you drive you&#x27;ll get an email with an update on your score.&lt;/p&gt;&lt;p&gt;We&#x27;ll let you know what your score is and give you some tips on where you need to improve.&lt;/p&gt;" modelFields="[question,answer]"></item_2>
          <item_3 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Faq List Item" model="faq-list-item" question="How to remove Admiral LittleBox" answer="&lt;p&gt;You can&#x27;t take out your LittleBox yourself. If you change from a black box policy, just give us a call and we&#x27;ll remotely deactivate it.&lt;/p&gt;&lt;p&gt;That means it won&#x27;t be collecting any driving data or getting any power from your car.&lt;/p&gt;&lt;p&gt;If you want it removed completely, we&#x27;ll tell the engineers to get in touch with you and arrange a date to get it sorted.&lt;/p&gt;" modelFields="[question,answer]"></item_3>
          <item_4 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Faq List Item" model="faq-list-item" question="Where is Admiral LittleBox fitted?" answer="&lt;p&gt;Usually, our engineers will fit the LittleBox behind the glovebox on the passenger side.&lt;/p&gt;&lt;p&gt;Don&#x27;t worry, it won&#x27;t be visible and it&#x27;s not going to get in your way!&lt;/p&gt;" modelFields="[question,answer]"></item_4>
          <item_5 jcr:primaryType="nt:unstructured" sling:resourceType="core/franklin/components/block/v1/block/item" name="Faq List Item" model="faq-list-item" question="Does LittleBox have a curfew, or can I drive at night?" answer="&lt;p&gt;There&#x27;s no curfew, don&#x27;t worry! But regularly driving at night, between 10pm and 4am, will lower your score.&lt;/p&gt;&lt;p&gt;That&#x27;s because people are more likely to be tired and the visibility is worse, so unfortunately accidents are more likely to happen.&lt;/p&gt;" modelFields="[question,answer]"></item_5>
        </block_1>
      </section_11>
      <section_12 sling:resourceType="core/franklin/components/section/v1/section" jcr:primaryType="nt:unstructured" model="section" modelFields="[name,sec-spacing,sec-spacing-bottom,sec-swoosh,style,container,sec-inside-container,sec-width]"></section_12>
