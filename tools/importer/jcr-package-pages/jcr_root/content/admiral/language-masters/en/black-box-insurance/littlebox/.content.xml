        <block sling:resourceType="core/franklin/components/block/v1/block" jcr:primaryType="nt:unstructured" classes_sticky="true" filter="hero-cta" image="/content/dam/admiral/en/images/blackbox/man-driving-car-desktop.jpg" imageAlt="Man driving a car" model="hero-cta" modelFields="[image,imageAlt,text,classes_sticky,classes_compact,classes_mini]" name="Hero Cta" text="&lt;p&gt;&lt;h1&gt;LittleBox Insurance&lt;/h1&gt;&lt;/p&gt;&lt;p&gt;&lt;h2&gt;Smart cover for safe drivers&lt;/h2&gt;&lt;/p&gt;&lt;p&gt;Drive safely and you could get a discount when it&#x27;s time to renew - it&#x27;s really that easy.&lt;/p&gt;">
